FoamFile
{
    version	2.0;
    format	ascii;
    class	dictionary;
    object	waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

seaLevel            0;

relaxationNames     ( inlet outlet );

initializationName  inlet;

waveType            DepthvaryingCurrent;

U                   ( 0 0 0 );

UF                  ( 1 0 0 );

ZC                  -5;

Tsoft               5;

localSeaLevel       0;

inletCoeffs
{
    waveType            DepthvaryingCurrent;
    profileType         constant;
    U                   ( 0.5 0 0 );
    UF                  ( 0.5 0 0 );
    ZC                  -5;
    Tsoft               5;
    localSeaLevel       0;

    relaxationZone
    {
        relaxationScheme    Spatial;
        relaxationShape     Rectangular;
        relaxType           INLET;
        startX              ( -10.11 0 -5 );
        endX                ( -2 0 2 );
        orientation         ( 1 0 0 );
    }
}

outletCoeffs
{
    waveType            DepthvaryingCurrent;
    profileType         constant;
    U                   ( 0.5 0 0 );
    UF                  ( 0.5 0 0 );
    ZC                  -5;
    Tsoft               5;
    localSeaLevel       0;

    relaxationZone
    {
        relaxationScheme    Spatial;
        relaxationShape     Rectangular;
        relaxType           OUTLET;
        startX              ( 2 0 -5 );
        endX                ( 10.11 0 2 );
        orientation         ( 1 0 0 );
    }
}



