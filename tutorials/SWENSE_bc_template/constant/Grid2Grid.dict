Grid2Grid       HOSNWT;

zMesh
{
    zMeshType       meshRatio;

    zMin            -5.0;
    zMax             1.0;

    nZMin            50;
    nZMax            50;

    zMinRatio        3.0;
    zMaxRatio        3.0;
}

HOSNWT
{
    type            NWT;

    filePath        constant/modes_HOS_SWENSE_clean.dat;

    extraInterpolationNumber 1;  // ExtraInterpolation Point (default = 1, Original HOS grid)

    interpolationOrder  3;       // 1 : Linear, 2: Quadratic, 3 : Cubic (default = 3)

    $zMesh

    writeLog        TRUE;
}
