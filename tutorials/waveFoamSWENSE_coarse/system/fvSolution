FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


solvers
{
    "alpha.water.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 1;
        cAlpha          1;
        icAlpha         0;

        MULESCorr       yes;
        nLimiterIter    5;
        alphaApplyPrevCorr  no;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0;
        minIter         2;
    }

    "alphaI.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 1;
        cAlpha          1;
        icAlpha         0;

        MULESCorr       yes;
        nLimiterIter    5;
        alphaApplyPrevCorr  no;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0;
        minIter         2;
    }

    "pcorr.*"
    {
        solver          PCG;
	preconditioner  DILU;
        smoother        DIC;
        agglomerator    faceAreaPair;
        mergeLevels     1;
        nCellsInCoarsestLevel 10;
        cacheAgglomeration true;

        tolerance       1e-08;
        relTol          0;
    };

    psiProj
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
    }
    "(p_rgh|pc)"
    {
        solver          GAMG;
        smoother        DIC;
        agglomerator    faceAreaPair;
        mergeLevels     1;
        nCellsInCoarsestLevel 10;
        cacheAgglomeration true;

        tolerance       1e-8;
        relTol          0;
    };

    "(p_rghFinal|pcFinal)"
    {
        $p_rgh;
        relTol          0;
    }

    "(U|Uc|k|omega).*"
    {
        solver          PBiCGStab;
	preconditioner DILU;
        nSweeps         1;

        tolerance       1e-8;
        relTol          0;
        minIter         2;
    };

    "cellDisplacement.*"
    {
        solver          GAMG;
        tolerance       1e-7;
        relTol          0;
        smoother        GaussSeidel;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    fsiTol              1e-3;
    fsiMaxIter          21;
    nOuterCorrectors    1;
    nCorrectors         3;
    nNonOrthogonalCorrector 0;
    correctPhi          no;
    moveMeshOuterCorrectors no;
    includeDivUInc      false;
}

relaxationFactors
{
    fields
    {
        ".*" 1;
    }
    equations
    {
        ".*" 1; 
    }
}

cache
{
    grad(U);
}


