#!/bin/sh
cd "${0%/*}" || exit 1    # Run from this directory

# Source tutorial run functions
. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions"

# The SWENSE modes file is not part of the repository (about 141 MB).
# Generate it first, see Readme.md.
if [ ! -f constant/modes_HOS_SWENSE_clean.dat ]; then
    echo "Missing constant/modes_HOS_SWENSE_clean.dat: generate it as described in Readme.md"
    exit 1
fi

runApplication blockMesh
runApplication waveIsoFoamSWENSE

