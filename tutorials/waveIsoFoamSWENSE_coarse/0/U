FoamFile
{
    version     2.0;
    format      binary;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    Front
    {
        type            empty;
    }
    Down
    {
        type            empty;
    }
    inlet
    {
        type            swenseWaveVelocity;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            swenseWaveVelocity;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            slip;
    }
    atmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
}


