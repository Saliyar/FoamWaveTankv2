#!/bin/bash

## Modified script to check and install Grid2Grid from GitHub if not found

function Grid2GridInstall()
{
    # Exit immediately if there is an error
    # set -e

    # Set the directory for Grid2Grid installation
    SRCDIR="Grid2Grid/"
    LIBRARY="$FOAM_USER_LIBBIN/libGrid2Grid.so"
    REPO_URL="https://github.com/LHEEA/Grid2Grid.git"

    # Check if libGrid2Grid.so exists in $FOAM_USER_LIBBIN
    if [ -f "${LIBRARY}" ]; then
        echo "libGrid2Grid.so is already present in \$FOAM_USER_LIBBIN."
        echo "Skipping the build process."
        return 0
    fi

    # Check for the 'Grid2Grid' folder
    if [ ! -d "${SRCDIR}" ] || [ -z "$(ls -A "${SRCDIR}")" ]; then
        echo "Grid2Grid folder not found or empty. Cloning from GitHub..."
        git clone "${REPO_URL}" "${SRCDIR}"
    fi

    echo "Grid2Grid folder is found and populated."

    # Check if the required GCC version is available
    GCCREQUIRE="4.9"
    CHECKGCC=$(printf '%s\n' "${GCCREQUIRE}" "`gcc -dumpversion`" | sort -V | head -n1)

    if [ ! "${CHECKGCC}" = "$GCCREQUIRE" ]; then
        echo "Grid2Grid: Requires GCC v4.9+ ... cannot compile"
        return 0
    fi

    # CRITICAL: Check FFTW3_LIB_PATH is valid BEFORE building
    if [ -z "$FFTW3_LIB_PATH" ] || [ ! -f "$FFTW3_LIB_PATH/libfftw3.a" ]; then
        echo ""
        echo "========== ERROR =========="
        echo "libfftw3.a not found at: $FFTW3_LIB_PATH"
        echo "Grid2Grid build STOPPED"
        echo ""
        echo "Available FFTW locations:"
        ls -la /usr/lib64/libfftw3* 2>/dev/null || echo "  /usr/lib64: not found"
        ls -la /usr/local/lib/libfftw3* 2>/dev/null || echo "  /usr/local/lib: not found"
        if [ -n "$FFTWDIR" ]; then
            echo "  FFTWDIR: $FFTWDIR"
        fi
        echo ""
        echo "To fix: module load fftw3 OR set FFTW3_LIB_PATH correctly"
        echo "=============================="
        echo ""
        return 1
    fi

    echo "FFTW3 library found at: $FFTW3_LIB_PATH/libfftw3.a"

    # Build process
    pushd "${SRCDIR}" || return
    echo "Building Grid2Grid..."
    echo "$(pwd)"

    # Patch Grid2GridOptions.cmake to use correct FFTW path (override hardcoded developer path)
    echo "Patching Grid2GridOptions.cmake with correct FFTW path..."
    sed -i "s|set(FFTW3_LIB_PATH  .*|set(FFTW3_LIB_PATH  $FFTW3_LIB_PATH)|" Grid2GridOptions.cmake

    cmake -S. -Bbuild -DBUILD_OF_LIB=ON -DCMAKE_FIND_LIBRARY_SUFFIXES=".so;.a" -DFFTW3_LIB_PATH="$FFTW3_LIB_PATH"
    cmake --build build

    # Move postG2G to the build directory
    mv postG2G build/.
    
    # Return to the previous directory
    popd
}

Grid2GridInstall
GRID2GRID_BUILD_RESULT=$?

# CRITICAL: Verify libGrid2Grid.so was actually created
if [ $GRID2GRID_BUILD_RESULT -ne 0 ]; then
    echo ""
    echo "========== ERROR =========="
    echo "Grid2Grid build failed (returned error code $GRID2GRID_BUILD_RESULT)"
    echo "Compilation STOPPED"
    echo "=============================="
    echo ""
    exit 1
fi

if [ ! -f "$FOAM_USER_LIBBIN/libGrid2Grid.so" ]; then
    echo ""
    echo "========== ERROR =========="
    echo "libGrid2Grid.so NOT FOUND after build!"
    echo "Expected location: $FOAM_USER_LIBBIN/libGrid2Grid.so"
    echo "Compilation STOPPED"
    echo ""
    echo "Check build log for cmake/compilation errors above."
    echo "=============================="
    echo ""
    exit 1
fi

echo "✓ libGrid2Grid.so successfully created at: $FOAM_USER_LIBBIN/libGrid2Grid.so"
echo ""

echo "====================================="
echo "    COMPILE FENTON4FOAM"
echo "====================================="

fentonName="fenton4Foam"

if [ ! -f "$WAVES_APPBIN/$fentonName" ]
then
    echo
    echo "Compiling fenton4Foam"
    echo
    cd $fentonName
    gfortran -o $WAVES_APPBIN/$fentonName $fentonName.f fft.f
    cd $OLDPWD
else
    echo
    echo "fenton4Foam has already been compiled"
    echo
fi