#!/bin/bash

## Modified script to check and install Grid2Grid from GitHub if not found

function Grid2GridInstall()
{
    # Exit immediately if there is an error
    # set -e

    # Set the directory for Grid2Grid installation
    SRCDIR="Grid2Grid/"
    LIBRARY="$FOAM_USER_LIBBIN/libGrid2Grid.so"
    REPO_URL="https://github.com/LHEEA/Grid2Grid.git"

    # Check if libGrid2Grid.so exists in $FOAM_USER_LIBBIN
    if [ -f "${LIBRARY}" ]; then
        echo "libGrid2Grid.so is already present in \$FOAM_USER_LIBBIN."
        echo "Skipping the build process."
        return 0
    fi

    # Check for the 'Grid2Grid' folder
    if [ ! -d "${SRCDIR}" ] || [ -z "$(ls -A "${SRCDIR}")" ]; then
        echo "Grid2Grid folder not found or empty. Cloning from GitHub..."
        git clone "${REPO_URL}" "${SRCDIR}"
    fi

    echo "Grid2Grid folder is found and populated."

    # Check if the required GCC version is available
    GCCREQUIRE="4.9"
    CHECKGCC=$(printf '%s\n' "${GCCREQUIRE}" "`gcc -dumpversion`" | sort -V | head -n1)

    if [ ! "${CHECKGCC}" = "$GCCREQUIRE" ]; then
        echo "Grid2Grid: Requires GCC v4.9+ ... cannot compile"
        return 0
    fi

  # Use FFTW3_LIB_PATH from environment (set by bashrc), or fall back to default
  FFTW_PATH=${FFTW3_LIB_PATH:-/usr/lib64}
  sed -i "s|set(FFTW3_LIB_PATH  .*|set(FFTW3_LIB_PATH  $FFTW_PATH)|" Grid2Grid/Grid2GridOptions.cmake

  # Patch CMakeLists.txt to accept both .so and .a libraries
  sed -i 's/find_library(FFTW_LIB_FLAG NAMES libfftw3.a/find_library(FFTW_LIB_FLAG NAMES libfftw3.so libfftw3.a/' Grid2Grid/CMakeLists.txt
  sed -i 's/find_library(LIBEXIST NAMES libfftw3.a/find_library(LIBEXIST NAMES libfftw3.so libfftw3.a/' Grid2Grid/CMakeLists.txt
  sed -i 's|set(FFTW_LIB_FLAG \${FFTW3_LIB_PATH}/libfftw3.a )|set(FFTW_LIB_FLAG ${FFTW3_LIB_PATH}/libfftw3.so)|' Grid2Grid/CMakeLists.txt

    # Build process
    pushd "${SRCDIR}" || return
    echo "Building Grid2Grid..."
    echo "$(pwd)"
    cmake -S. -Bbuild -DBUILD_OF_LIB=ON -DCMAKE_FIND_LIBRARY_SUFFIXES=".so;.a"
    cmake --build build

    # Move postG2G to the build directory
    mv postG2G build/.

    # Return to the previous directory
    popd
}

Grid2GridInstall

echo "====================================="
echo "    COMPILE GEOMETRIC GRAVITY MODELS"
echo "====================================="

function GeometricGravityInstall()
{
    SRCDIR="geometricGravity/"
    LIBRARY="$FOAM_USER_LIBBIN/libgravityModels.so"

    # Check if libraries already exist
    if [ -f "${LIBRARY}" ]; then
        echo "libgravityModels.so is already present in \$FOAM_USER_LIBBIN."
        echo "Skipping geometricGravity build."
        return 0
    fi

    # Check if geometricGravity folder exists (as submodule)
    if [ ! -d "${SRCDIR}" ]; then
        echo "WARNING: geometricGravity folder not found at ${SRCDIR}"
        echo "Make sure git submodule is initialized: git submodule update --init ThirdParty/geometricGravity"
        echo "Continuing without gravityModels - you must have libgravityModels.so available separately."
        return 0
    fi

    echo "Building geometricGravity gravityModels and newGeometricVoF libraries..."
    pushd "${SRCDIR}" || return 0
    echo "$(pwd)"

    # Build only the libraries we need, not utilities or applications
    echo "Building newGeometricVoF library..."
    (cd newGeometricVoF && wmake libso)

    echo "Building gravityModels library..."
    (cd gravityModels && wmake libso)

    popd

    # Check if gravityModels was built
    if [ -f "${LIBRARY}" ]; then
        echo "SUCCESS: libgravityModels.so built and available"
    else
        echo "WARNING: libgravityModels.so not found - make sure gravityModels library built successfully"
    fi

    return 0
}

GeometricGravityInstall

echo "====================================="
echo "    COMPILE FENTON4FOAM"
echo "====================================="

fentonName="fenton4Foam"

if [ ! -f "$WAVES_APPBIN/$fentonName" ]
then
    echo
    echo "Compiling fenton4Foam"
    echo
    cd $fentonName
    gfortran -o $WAVES_APPBIN/$fentonName $fentonName.f fft.f
    cd $OLDPWD
else
    echo
    echo "fenton4Foam has already been compiled"
    echo
fi
