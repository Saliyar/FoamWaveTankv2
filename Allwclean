#!/bin/bash 

## Set environmental variables
. ./bin/bashrc


## COMPILE THIRD PARTY DEPENDENCIES
echo "====================================="
echo "    CLEAN ThirdParty"
echo "====================================="
(cd ThirdParty; ./Allclean)


## LIBRARY
echo "====================================="
echo "    CLEAN LIBRARY"
echo "====================================="

( cd src; wclean all )


## SOLVERS
# Find all solver names in $WAVES_SOL
echo ""
echo "====================================="
echo "    CLEAN SOLVERS"
echo "====================================="

for dir in "$WAVES_DIR/applications/solvers"/wave*; do
  if [ -d "$dir" ]; then
    echo "Cleaning solver: $(basename "$dir")"
    (cd "$dir" && wclean all)
  fi
done


## UTILITIES
echo ""
echo "====================================="
echo "    CLEAN UTILITIES"
echo "====================================="

(cd "$WAVES_DIR/applications/utilities/"; wclean all)

echo ""
echo "====================================="
echo "    CLEAN DONE"
echo "====================================="
echo ""
