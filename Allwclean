#!/bin/bash 

## Set environmental variables
. ./bin/bashrc


## COMPILE THIRD PARTY DEPENDENCIES
echo "====================================="
echo "    CLEAN ThirdParty"
echo "====================================="
(cd ThirdParty; ./Allclean)


## LIBRARY
echo "====================================="
echo "    CLEAN LIBRARY"
echo "====================================="

( cd src; wclean all )


## SOLVERS
# Find all solver names in $WAVES_SOL
echo ""
echo "====================================="
echo "    CLEAN SOLVERS"
echo "====================================="

for dir in "$WAVES_DIR/applications/solvers"/wave*; do
  if [ -d "$dir" ]; then
    echo "Cleaning solver: $(basename "$dir")"
    (cd "$dir" && wclean all)
  fi
done


## FLOAT STEPPER WITH WAVES
echo ""
echo "====================================="
echo "    CLEAN FLOATSTEPPERWAVEISOFOAM"
echo "====================================="

if [ -d "applications/solvers/floatStepperWaveIsoFoam" ]
then
    ( cd applications/solvers/floatStepperWaveIsoFoam; ./Allwclean )
    if [ $? -ne 0 ]
    then
        echo "WARNING: floatStepperWaveIsoFoam cleaning had issues"
    fi
else
    echo "WARNING: floatStepperWaveIsoFoam directory not found"
fi


## UTILITIES
echo ""
echo "====================================="
echo "    CLEAN UTILITIES"
echo "====================================="

(cd "$WAVES_DIR/applications/utilities/"; wclean all)

echo ""
echo "====================================="
echo "    CLEAN DONE"
echo "====================================="
echo ""

# Remove build log
[ -f log.build ] && rm log.build && echo "Removed log.build"
