#!/bin/bash

# Log build output to log.build
exec 1> >(tee log.build)
exec 2>&1

##############################################################################
## USER CONFIGURATION - Override FFTW library location if needed
##############################################################################
# Leave empty to auto-detect (recommended for servers with module system)
# Or set to your custom FFTW library path, e.g.:
#   USER_FFTW3_LIB_PATH="/usr/local/fftw/lib"
#   USER_FFTW3_LIB_PATH="/home/user/fftw-3.3.10/lib"
#   USER_FFTW3_LIB_PATH="/appl/fftw/lib"
USER_FFTW3_LIB_PATH=""
##############################################################################

# Timing
BUILD_START=$(date +%s)
echo "========================================="
echo "Build started: $(date)"
echo "========================================="

## Making sure that prepareCase.sh is executable
if [ ! -x "bin/prepareCase.sh" ]
then
    chmod a+x bin/prepareCase.sh
fi

## Make sure that bashrc is executable
if [ ! -f "./bin/bashrc" ]
then
    cp ./bin/bashrc.org ./bin/bashrc
    chmod a+x ./bin/bashrc
fi

## Set environmental variables
. ./bin/bashrc

##############################################################################
## PREREQUISITES: find out where we are building and check what is needed
##############################################################################
#   server : a module system is available (HPC cluster)
#   ubuntu : Ubuntu / Debian PC, laptop or WSL
#   rhel   : Fedora / RHEL / Rocky / Alma / CentOS
#   other  : any other Linux or macOS
# Nothing is installed without asking. Third-party codes (Grid2Grid, MoorDyn,
# FloatStepper) are downloaded and built by this script; only the compilers,
# cmake, git, FFTW, GSL and OpenFOAM must come from the system.
echo "====================================="
echo "    CHECKING PREREQUISITES"
echo "====================================="

OS_ID=""
OS_LIKE=""
if [ -f /etc/os-release ]; then
    OS_ID=$(. /etc/os-release; echo "$ID")
    OS_LIKE=$(. /etc/os-release; echo "$ID_LIKE")
fi
if command -v module >/dev/null 2>&1; then
    PLATFORM=server
elif echo " $OS_ID $OS_LIKE " | grep -q -e " ubuntu " -e " debian "; then
    PLATFORM=ubuntu
elif echo " $OS_ID $OS_LIKE " | grep -q -e " fedora " -e " rhel " -e " centos "; then
    PLATFORM=rhel
else
    PLATFORM=other
fi
grep -qi microsoft /proc/version 2>/dev/null && IS_WSL=" (WSL)" || IS_WSL=""
echo "Platform: $PLATFORM${IS_WSL}  (${OS_ID:-$(uname -s)})"

# On a server, try to load FFTW and GSL modules if they are not loaded yet
if [ "$PLATFORM" = server ]; then
    for m in fftw/3.3.10 fftw3/3.3.10 fftw fftw3; do
        [ -n "$FFTWDIR" ] && break
        module load "$m" >/dev/null 2>&1 && echo "  module load $m"
    done
fi

MISSING=""        # names for the error message
PKG_UBUNTU=""     # apt packages to install
PKG_RHEL=""       # dnf packages to install
need () { MISSING="$MISSING $1"; PKG_UBUNTU="$PKG_UBUNTU $2"; PKG_RHEL="$PKG_RHEL $3"; }

command -v gcc      >/dev/null 2>&1 || need gcc      build-essential gcc
command -v g++      >/dev/null 2>&1 || need g++      build-essential gcc-c++
command -v make     >/dev/null 2>&1 || need make     build-essential make
command -v gfortran >/dev/null 2>&1 || need gfortran gfortran        gcc-gfortran
command -v cmake    >/dev/null 2>&1 || need cmake    cmake           cmake
command -v git      >/dev/null 2>&1 || need git      git             git

# FFTW: Grid2Grid needs the static library libfftw3.a
MULTIARCH=$(gcc -print-multiarch 2>/dev/null)
if [ -n "$USER_FFTW3_LIB_PATH" ]; then
    FFTW_CANDIDATES="$USER_FFTW3_LIB_PATH"
else
    FFTW_CANDIDATES="$FFTW3_LIB_PATH $FFTWDIR $FFTW_LIB \
        $(echo "$LIBRARY_PATH:$LD_LIBRARY_PATH" | tr ':' ' ') \
        ${MULTIARCH:+/usr/lib/$MULTIARCH} /usr/lib/x86_64-linux-gnu \
        /usr/lib/aarch64-linux-gnu /usr/lib64 /usr/lib /usr/local/lib \
        /usr/local/lib64 /opt/homebrew/lib"
fi
FFTW3_FOUND=""
for d in $FFTW_CANDIDATES; do
    [ -f "$d/libfftw3.a" ] && { FFTW3_FOUND="$d"; break; }
done
if [ -n "$FFTW3_FOUND" ]; then
    export FFTW3_LIB_PATH="$FFTW3_FOUND"
    echo "  FFTW  : $FFTW3_LIB_PATH/libfftw3.a"
else
    need "FFTW(libfftw3.a)" libfftw3-dev "fftw-devel fftw-static"
fi

# GSL: waves2Foam needs the headers and the library
GSL_TEST=$(mktemp -d 2>/dev/null || echo /tmp/fwt_gsl_$$)
mkdir -p "$GSL_TEST"
printf '#include <gsl/gsl_errno.h>\nint main(){return gsl_strerror(0)==0;}\n' > "$GSL_TEST/t.c"
if command -v gcc >/dev/null 2>&1 && \
   gcc "$GSL_TEST/t.c" -o "$GSL_TEST/t" ${WAVES_GSL_INCLUDE:+-I$WAVES_GSL_INCLUDE} \
       ${WAVES_GSL_LIB:+-L$WAVES_GSL_LIB} -lgsl -lgslcblas -lm >/dev/null 2>&1
then
    echo "  GSL   : found"
else
    need GSL libgsl-dev gsl-devel
fi
rm -rf "$GSL_TEST"

# OpenFOAM: must be loaded in this terminal (wmake and $WM_PROJECT_DIR)
OF_OK=1
if [ -z "$WM_PROJECT_DIR" ] || ! command -v wmake >/dev/null 2>&1; then
    OF_OK=0
    MISSING="$MISSING OpenFOAM(not loaded)"
else
    echo "  OpenFOAM: $WM_PROJECT_VERSION ($WM_PROJECT_DIR)"
    case "$WM_PROJECT_VERSION" in
        v2506) ;;
        v*) echo "  NOTE: FoamWaveTank is tested with OpenFOAM v2506 (openfoam.com)." ;;
        *)  echo "  WARNING: this looks like the openfoam.org version. FoamWaveTank"
            echo "           needs the openfoam.com version (v2506)." ;;
    esac
fi

if [ -n "$MISSING" ]; then
    # unique package lists
    PKG_UBUNTU=$(echo $PKG_UBUNTU | tr ' ' '\n' | awk 'NF && !s[$0]++' | tr '\n' ' ')
    PKG_RHEL=$(echo $PKG_RHEL | tr ' ' '\n' | awk 'NF && !s[$0]++' | tr '\n' ' ')
    echo ""
    echo "MISSING:$MISSING"
    echo ""
    case "$PLATFORM" in
    server)
        echo "Load the modules before ./Allwmake, for example on the DTU cluster:"
        echo "  module load gcc gsl fftw cmake openfoam.com/2506"
        echo "  source \$WM_PROJECT_DIR/etc/bashrc     # if the module asks for it"
        ;;
    ubuntu)
        [ -n "$PKG_UBUNTU" ] && echo "Install with:  sudo apt update && sudo apt install -y $PKG_UBUNTU"
        if [ -n "$PKG_UBUNTU" ] && [ -t 0 ] && command -v sudo >/dev/null 2>&1; then
            printf "Install these packages now with sudo apt? [y/N] "
            read -r answer
            if [ "$answer" = y ] || [ "$answer" = Y ]; then
                sudo apt update && sudo apt install -y $PKG_UBUNTU || exit 1
                echo "Packages installed. Run ./Allwmake again."
                [ "$OF_OK" = 1 ] && exit 0
            fi
        fi
        ;;
    rhel)
        [ -n "$PKG_RHEL" ] && echo "Install with:  sudo dnf install -y $PKG_RHEL"
        ;;
    *)
        echo "Install the missing tools with your package manager."
        ;;
    esac
    if [ "$OF_OK" = 0 ]; then
        echo ""
        echo "OpenFOAM v2506 (openfoam.com) is not loaded in this terminal."
        OF_RC=$(ls -d /usr/lib/openfoam/openfoam*/etc/bashrc "$HOME"/OpenFOAM/OpenFOAM-v*/etc/bashrc 2>/dev/null | tail -1)
        if [ -n "$OF_RC" ]; then
            echo "  It is installed. Load it, then run ./Allwmake again:"
            echo "    source $OF_RC"
        elif [ "$PLATFORM" = ubuntu ]; then
            echo "  Install it (Ubuntu/WSL), load it, then run ./Allwmake again:"
            echo "    curl -s https://dl.openfoam.com/add-debian-repo.sh | sudo bash"
            echo "    sudo apt install -y openfoam2506-default"
            echo "    source /usr/lib/openfoam/openfoam2506/etc/bashrc"
        elif [ "$PLATFORM" = server ]; then
            echo "    module load openfoam.com/2506"
        else
            echo "  See https://develop.openfoam.com/Development/openfoam/-/wikis/precompiled"
        fi
    fi
    echo ""
    echo "EXITING: nothing was compiled."
    exit 1
fi

echo "All prerequisites found."
echo "====================================="
echo ""

## Check if WAVES_DIR exists
if [ ! -d "$WAVES_DIR" ]
then
    echo ""
    echo "FATAL ERROR."
    echo "    The directory path "$WAVES_DIR "does not exist."
    echo "    Correct the path in bin/bashrc"
    echo ""
    echo "    This means that you should correct the environmental variable \$WAVES_DIR"
    echo "    such that it is pointed (in absolute sense) to the path, where waves2Foam"
    echo "    is located."
    echo ""
    echo "    Please note that once bin/bashrc is created, bin/bashrc.org is only an"
    echo "    inactive file. The latter is also the only of the two files, which is"
    echo "    updated through the SVN-repository."
    echo ""
    echo "EXITING"
    echo ""

    exit 1
fi

# Hard-coded creation of the target for the compiled libraries, solvers and utilities
# This is needed, because the Third-party installation does not use wmake, i.e. if
# the directory does not exist, it means that all subsequent OpenFoam/waves2Foam
# parts of the installation will fail!
if [ ! -d "$WAVES_APPBIN" ]
then
    mkdir -p $WAVES_APPBIN
fi

if [ ! -d "$WAVES_LIBBIN" ]
then
    mkdir -p $WAVES_LIBBIN
fi

## Ensure git submodules are initialized and updated to latest remote
if [ -f ".gitmodules" ]; then
    echo "Syncing submodule configuration..."
    git submodule sync --recursive
    echo "Updating git submodules to latest remote..."
    git submodule update --init --remote
fi

## COMPILE THIRD PARTY DEPENDENCIES
(cd ThirdParty; ./Allwmake -j 2)

if [[ $? -ne 0 ]]
then
    echo ""
    echo "Problems with the compilation of the third party dependencies"
    echo "Exiting"
    echo ""
    exit 1
fi

## LIBRARY
echo "====================================="
echo "    COMPILE LIBRARY"
echo "====================================="
( cd src; ./Allwmake -j 2)
if [ $? -ne 0 ]; then
    echo ""
    echo "ERROR: src build failed"
    exit 1
fi

## SOLVERS
# Find all solver names in $WAVES_SOL
echo ""
echo "====================================="
echo "    COMPILE SOLVERS"
echo "====================================="
solvers=`ls -d $WAVES_SOL/wave*`

# Loop over the solver names
for s in $solvers
do
    echo "Full path:$s"
     solverName=`basename $s`
     echo "Compiling solver: $solverName"

    # Correct options file if extend branch or not
    if [ "$EXTBRANCH" -eq "1" ]
    then
        if [ "$FOAMEXTENDPROJECT" -eq "0" ]
        then
            rm -f $WAVES_SOL/$solverName/Make/options
            ln -s -f $WAVES_SOL/$solverName/Make/options.ext $WAVES_SOL/$apps/$solverName/Make/options
        fi
    else
        if [ -f $WAVES_SOL/$solverName/Make/options.reg ]
        then
            rm -f $WAVES_SOL/$solverName/Make/options
            ln -s -f $WAVES_SOL/$solverName/Make/options.reg $WAVES_SOL/$apps/$solverName/Make/options
        fi
    fi

    # Compile the solver
    ( cd $WAVES_SOL/$solverName; wmake )
done

## FLOAT STEPPER WITH WAVES
# Compile FloatStepper (floatStepper, floatStepperWaveIsoFoam) with integrated waves2Foam coupling
echo ""
echo "====================================="
echo "    COMPILE FLOATSTEPPERWAVEISOFOAM"
echo "====================================="
if [ -d "applications/solvers/floatStepperWaveIsoFoam" ]
then
    # Build ThirdParty (MoorDyn) and wrapper - includes all src/ and applications/
    ( cd applications/solvers/floatStepperWaveIsoFoam; ./Allwmake )
    if [ $? -ne 0 ]
    then
        echo ""
        echo "WARNING: floatStepperWaveIsoFoam compilation had issues"
        echo ""
    fi
else
    echo "WARNING: floatStepperWaveIsoFoam directory not found"
fi

# Compile MoorDyn restraints for sixDoFRigidBodyMotion (waveFoam, waveIsoFoam)
echo ""
echo "====================================="
echo "    COMPILE MOORDYN SIXDOF RESTRAINTS"
echo "====================================="
if [ -f "$FOAM_USER_LIBBIN/libmoordyn_v1.so" ]
then
    ( cd src/moorDynSixDoF/moorDynR1; wmake libso )
else
    echo "WARNING: libmoordyn_v1.so not found, skipping moorDynR1SixDoF"
fi
if [ -f "$FOAM_USER_LIBBIN/libmoordyn.so" ] \
&& [ -d "applications/solvers/floatStepperWaveIsoFoam/ThirdParty/MoorDyn/submodules/MoorDyn.build/include/moordyn" ]
then
    ( cd src/moorDynSixDoF/moorDynR2; wmake libso )
else
    echo "WARNING: libmoordyn.so or MoorDyn v2 headers not found, skipping moorDynR2SixDoF"
fi

## UTILITIES
# Pre-processing utilities
echo ""
echo "====================================="
echo "    COMPILE PRE-PROCESSING"
echo "====================================="
foamOpenFOAM="$WAVES_PRE/faceSetToSTL $WAVES_PRE/waveGaugesNProbes $WAVES_POST/postProcessWaves2Foam"

for i in $foamOpenFOAM
do
    rm -f $i/Make/options

    if [ "$FOAMEXTENDPROJECT" -eq "0" ]
    then
        if [ "$OFPLUSBRANCH" -eq "1" ]
        then
            if [ "$WM_PROJECT_VERSION_NUMBER" -lt 1706 ]
            then
                ln -s -f options.OpenFOAM $i/Make/options
            else
                ln -s -f options.OpenFOAMPlus1706 $i/Make/options
            fi
        else
            ln -s -f options.OpenFOAM $i/Make/options
        fi
    else
        if [ "$WM_PROJECT_VERSION_NUMBER" -lt 320 ]
        then
            ln -s -f options.foam $i/Make/options
        else
            ln -s -f options.foam.320 $i/Make/options
        fi
    fi
done

# Compile the setWaveField and account for the inclusion of lwaveModels (IHFoam) as of 2012-ESI
# Note: GABC disabled for v2606+ due to C++ compatibility issues
if [ "$OFPLUSBRANCH" -eq "1" ]
then
    if [ "$WM_PROJECT_VERSION_NUMBER" -lt 1812 ]
    then
        ln -s -f optionsNonGABC $WAVES_PRE/setWaveField/Make/options
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt 2012 ]
    then
        ln -s -f optionsPre2012 $WAVES_PRE/setWaveField/Make/options
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt 2606 ]
    then
        ln -s -f options2012 $WAVES_PRE/setWaveField/Make/options
    else
        ln -s -f optionsNonGABC $WAVES_PRE/setWaveField/Make/options
    fi
else
    ln -s -f optionsNonGABC $WAVES_PRE/setWaveField/Make/options
fi

( cd $WAVES_PRE && wmake all )

# Post-processing utilities - Post processing removed from compilation Jan. 2021
# echo ""
# echo "====================================="
# echo "    COMPILE POST-PROCESSING"
# echo "====================================="
# rm -f $WAVES_POST/surfaceElevation/Make/options
# 
# if [ "$EXTBRANCH" -eq "1" ]
# then
#     ln -s -f options.210 $WAVES_POST/surfaceElevation/Make/options
# elif [ "$OFPLUSBRANCH" -eq "1" ]
# then
#     ln -s -f options.220 $WAVES_POST/surfaceElevation/Make/options
# elif [ "$WM_PROJECT_VERSION_NUMBER" -lt "220" ]
# then
#     ln -s -f options.210 $WAVES_POST/surfaceElevation/Make/options
# else
#     ln -s -f options.220 $WAVES_POST/surfaceElevation/Make/options
# fi
# 
# Currently, only compile waves2FoamSampling for all Openfoam versions except
# for OpenFOAM-4.0
# if [ $FOAMEXTENDPROJECT -eq "0" ]
# then
#     if [ "$OFPLUSBRANCH" -eq "1" ]
#     then
#         if [ "$WM_PROJECT_VERSION_NUMBER" -lt "1612" ]
#         then
#             ( cd $WAVES_POST && wmake all)
#         else
#             ( cd $WAVES_POST/postProcessWaves2Foam; wmake)
#         fi
#     else
#         if [ "$WM_PROJECT_VERSION_NUMBER" -lt "400" ]
#         then
#             ( cd $WAVES_POST && wmake all )
#         else
#             ( cd $WAVES_POST/postProcessWaves2Foam; wmake)
#         fi
#     fi
# else
#     ( cd $WAVES_POST && wmake all )
# fi
# 

## CHECK THAT EVERYTHING A STUDENT NEEDS WAS BUILT
echo ""
echo "====================================="
echo "    CHECKING THE BUILD"
echo "====================================="
BUILD_FAILED=""
for b in waveFoam waveIsoFoam floatStepper floatStepperWaveIsoFoam \
         setWaveField setWaveParameters relaxationZoneLayout waveGaugesNProbes
do
    [ -x "$WAVES_APPBIN/$b" ] || BUILD_FAILED="$BUILD_FAILED $b"
done
for l in libwaves2Foam.so libGrid2Grid.so libmoordyn_v1.so libmoordyn.so \
         libmoorDynR1SixDoF.so libmoorDynR2SixDoF.so
do
    [ -f "$WAVES_LIBBIN/$l" ] || BUILD_FAILED="$BUILD_FAILED $l"
done

echo ""
echo "====================================="
if [ -n "$BUILD_FAILED" ]
then
    echo "    COMPILATION FAILED"
    echo "    Not built:$BUILD_FAILED"
    echo "    Search log.build for the first \"error\"."
else
    echo "    COMPILATION DONE"
    echo "    All solvers and libraries are in"
    echo "      $WAVES_APPBIN"
    echo "      $WAVES_LIBBIN"
fi
echo "====================================="

# Calculate and display total build time
BUILD_END=$(date +%s)
BUILD_TIME=$((BUILD_END - BUILD_START))
BUILD_HOURS=$((BUILD_TIME / 3600))
BUILD_MINS=$(((BUILD_TIME % 3600) / 60))
BUILD_SECS=$((BUILD_TIME % 60))

echo ""
echo "Build finished: $(date)"
echo "Total build time: ${BUILD_HOURS}h ${BUILD_MINS}m ${BUILD_SECS}s"
echo "====================================="
echo ""

[ -z "$BUILD_FAILED" ]
