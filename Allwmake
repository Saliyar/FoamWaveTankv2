#!/bin/bash

# Log build output to log.build
exec 1> >(tee log.build)
exec 2>&1

##############################################################################
## Usage:  ./Allwmake [-j N]
##
## Only OpenFOAM, gcc/gfortran, cmake and GSL are needed. FFTW is found
## automatically, or built once from source (see ThirdParty/Allwmake).
##
## USER CONFIGURATION - optional, leave empty for automatic detection
##   Directory holding libfftw3.a, e.g. "/appl/fftw/3.3.10/lib"
USER_FFTW3_LIB_PATH=""
##############################################################################

# Parallel compilation: "-j N", else WM_NCOMPPROCS, else all cores.
# wmake picks up WM_NCOMPPROCS for every library and solver below.
if [ "$1" = "-j" ] && [ -n "$2" ]; then
    export WM_NCOMPPROCS="$2"
elif [ -z "$WM_NCOMPPROCS" ]; then
    export WM_NCOMPPROCS="$(nproc 2>/dev/null || echo 2)"
fi

# Timing
BUILD_START=$(date +%s)
echo "========================================="
echo "Build started: $(date)"
echo "========================================="

## Making sure that prepareCase.sh is executable
if [ ! -x "bin/prepareCase.sh" ]
then
    chmod a+x bin/prepareCase.sh
fi

## Make sure that bashrc is executable
if [ ! -f "./bin/bashrc" ]
then
    cp ./bin/bashrc.org ./bin/bashrc
    chmod a+x ./bin/bashrc
fi

## Set environmental variables
. ./bin/bashrc

if [ -n "$USER_FFTW3_LIB_PATH" ]; then
    export FFTW3_LIB_PATH="$USER_FFTW3_LIB_PATH"
fi

## Check prerequisites before compiling anything
echo "====================================="
echo "    CHECKING PREREQUISITES"
echo "====================================="
missing=""
if [ -z "$WM_PROJECT_DIR" ] || [ -z "$FOAM_USER_LIBBIN" ] || ! command -v wmake > /dev/null; then
    missing="$missing\n  - OpenFOAM environment: source OpenFOAM first (module load ... or . <OpenFOAM>/etc/bashrc)"
fi
for tool in gcc g++ gfortran cmake make tar; do
    if ! command -v $tool > /dev/null; then
        missing="$missing\n  - $tool"
    fi
done
if [ -n "$missing" ]; then
    echo ""
    echo -e "ERROR: missing prerequisites:$missing"
    echo ""
    echo "  Ubuntu/Debian: sudo apt install build-essential gfortran cmake libgsl-dev"
    echo "  RHEL/Rocky:    sudo dnf install gcc gcc-c++ gcc-gfortran cmake gsl-devel"
    echo "  Cluster:       module load gcc cmake gsl (names differ per cluster)"
    echo ""
    exit 1
fi

gslFound=0
for d in "$WAVES_GSL_INCLUDE" /usr/include /usr/local/include $(echo "$CPATH:$C_INCLUDE_PATH" | tr ':' ' '); do
    [ -f "$d/gsl/gsl_math.h" ] && gslFound=1 && break
done
if [ $gslFound -eq 0 ] && command -v gsl-config > /dev/null; then
    gslFound=1
fi
if [ $gslFound -eq 0 ]; then
    echo "WARNING: GSL headers (gsl/gsl_math.h) not found. If the library build fails,"
    echo "  install libgsl-dev / gsl-devel, or set WAVES_GSL_INCLUDE and WAVES_GSL_LIB in bin/bashrc"
fi
echo "OpenFOAM $WM_PROJECT_VERSION, compiling with $WM_NCOMPPROCS parallel jobs"
echo ""

## Check if WAVES_DIR exists
if [ ! -d "$WAVES_DIR" ]
then
    echo ""
    echo "FATAL ERROR."
    echo "    The directory path "$WAVES_DIR "does not exist."
    echo "    Correct the path in bin/bashrc"
    echo ""
    echo "    This means that you should correct the environmental variable \$WAVES_DIR"
    echo "    such that it is pointed (in absolute sense) to the path, where waves2Foam"
    echo "    is located."
    echo ""
    echo "    Please note that once bin/bashrc is created, bin/bashrc.org is only an"
    echo "    inactive file. The latter is also the only of the two files, which is"
    echo "    updated through the SVN-repository."
    echo ""
    echo "EXITING"
    echo ""

    exit
fi

# Hard-coded creation of the target for the compiled libraries, solvers and utilities
# This is needed, because the Third-party installation does not use wmake, i.e. if
# the directory does not exist, it means that all subsequent OpenFoam/waves2Foam
# parts of the installation will fail!
if [ ! -d "$WAVES_APPBIN" ]
then
    mkdir -p $WAVES_APPBIN
fi

if [ ! -d "$WAVES_LIBBIN" ]
then
    mkdir -p $WAVES_LIBBIN
fi

## Fetch git submodules at the commits pinned by this repository, so every
## install builds the same Grid2Grid and FloatStepper. To move a submodule to
## its latest upstream version instead: git submodule update --remote <path>
if [ -f ".gitmodules" ] && [ -e ".git" ]; then
    echo "Fetching git submodules..."
    git submodule sync --recursive
    git submodule update --init
fi

## COMPILE THIRD PARTY DEPENDENCIES
(cd ThirdParty; ./Allwmake -j "$WM_NCOMPPROCS")

if [[ $? -ne 0 ]]
then
    echo ""
    echo "Problems with the compilation of the third party dependencies"
    echo "Exiting"
    echo ""
    exit 1
fi

## LIBRARY
echo "====================================="
echo "    COMPILE LIBRARY"
echo "====================================="
( cd src; ./Allwmake )
if [ $? -ne 0 ]; then
    echo ""
    echo "ERROR: src build failed"
    exit 1
fi

## SOLVERS
# Find all solver names in $WAVES_SOL
echo ""
echo "====================================="
echo "    COMPILE SOLVERS"
echo "====================================="
solvers=`ls -d $WAVES_SOL/wave*`

# Loop over the solver names
for s in $solvers
do
    echo "Full path:$s"
     solverName=`basename $s`
     echo "Compiling solver: $solverName"

    # Correct options file if extend branch or not
    if [ "$EXTBRANCH" -eq "1" ]
    then
        if [ "$FOAMEXTENDPROJECT" -eq "0" ]
        then
            rm -f $WAVES_SOL/$solverName/Make/options
            ln -s -f $WAVES_SOL/$solverName/Make/options.ext $WAVES_SOL/$apps/$solverName/Make/options
        fi
    else
        if [ -f $WAVES_SOL/$solverName/Make/options.reg ]
        then
            rm -f $WAVES_SOL/$solverName/Make/options
            ln -s -f $WAVES_SOL/$solverName/Make/options.reg $WAVES_SOL/$apps/$solverName/Make/options
        fi
    fi

    # Compile the solver
    ( cd $WAVES_SOL/$solverName; wmake )
done

## FLOAT STEPPER WITH WAVES
# Compile floatStepperWaveFoam with integrated waves2Foam coupling
echo ""
echo "====================================="
echo "    COMPILE FLOATSTEPPERWAVEFOAM"
echo "====================================="
if [ -d "applications/solvers/floatStepperWaveFoam" ]
then
    # Build ThirdParty (MoorDyn) and wrapper - includes all src/ and applications/
    ( cd applications/solvers/floatStepperWaveFoam; ./Allwmake )
    if [ $? -ne 0 ]
    then
        echo ""
        echo "WARNING: floatStepperWaveFoam compilation had issues"
        echo ""
    fi
else
    echo "WARNING: floatStepperWaveFoam directory not found"
fi

## UTILITIES
# Pre-processing utilities
echo ""
echo "====================================="
echo "    COMPILE PRE-PROCESSING"
echo "====================================="
foamOpenFOAM="$WAVES_PRE/faceSetToSTL $WAVES_PRE/waveGaugesNProbes $WAVES_POST/postProcessWaves2Foam"

for i in $foamOpenFOAM
do
    rm -f $i/Make/options

    if [ "$FOAMEXTENDPROJECT" -eq "0" ]
    then
        if [ "$OFPLUSBRANCH" -eq "1" ]
        then
            if [ "$WM_PROJECT_VERSION_NUMBER" -lt 1706 ]
            then
                ln -s -f $i/Make/options.OpenFOAM $i/Make/options
            else
                ln -s -f $i/Make/options.OpenFOAMPlus1706 $i/Make/options
            fi
        else
            ln -s -f $i/Make/options.OpenFOAM $i/Make/options
        fi
    else
        if [ "$WM_PROJECT_VERSION_NUMBER" -lt 320 ]
        then
            ln -s -f $i/Make/options.foam $i/Make/options
        else
            ln -s -f $i/Make/options.foam.320 $i/Make/options
        fi
    fi
done

# Compile the setWaveField and account for the inclusion of lwaveModels (IHFoam) as of 2012-ESI
# Note: GABC disabled for v2606+ due to C++ compatibility issues
if [ "$OFPLUSBRANCH" -eq "1" ]
then
    if [ "$WM_PROJECT_VERSION_NUMBER" -lt 1812 ]
    then
        ln -s -f $WAVES_PRE/setWaveField/Make/optionsNonGABC $WAVES_PRE/setWaveField/Make/options
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt 2012 ]
    then
        ln -s -f $WAVES_PRE/setWaveField/Make/optionsPre2012 $WAVES_PRE/setWaveField/Make/options
    elif [ "$WM_PROJECT_VERSION_NUMBER" -lt 2606 ]
    then
        ln -s -f $WAVES_PRE/setWaveField/Make/options2012 $WAVES_PRE/setWaveField/Make/options
    else
        ln -s -f $WAVES_PRE/setWaveField/Make/optionsNonGABC $WAVES_PRE/setWaveField/Make/options
    fi
else
    ln -s -f $WAVES_PRE/setWaveField/Make/optionsNonGABC $WAVES_PRE/setWaveField/Make/options
fi

( cd $WAVES_PRE && wmake all )

# Post-processing utilities - Post processing removed from compilation Jan. 2021
