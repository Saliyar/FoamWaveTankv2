EXE_INC = \
    -DOFVERSION=$(WM_PROJECT_VERSION_NUMBER) \
    -DEXTBRANCH=$(EXTBRANCH) \
    -DXVERSION=$(WAVES_XVERSION) \
    -DOFPLUSBRANCH=$(OFPLUSBRANCH) \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/lagrangian/basic/lnInclude \
    -I$(LIB_SRC)/fileFormats/lnInclude \
    -I$(WAVES_GSL_INCLUDE) \
    -I../../ThirdParty/Grid2Grid/lib
    
LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -lsampling \
    -lfileFormats \
    -lstdc++ \
    -lgfortran \
    -L$(WAVES_LIBBIN) \
    -L$(WAVES_GSL_LIB) \
    -L../../ThirdParty/Grid2Grid/lib \
    -lGrid2Grid \
    -Wl,-rpath,$(WAVES_DIR)/ThirdParty/Grid2Grid/lib \
    -lgsl \
    -lgslcblas
